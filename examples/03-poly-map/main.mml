(export (map : ((a b) (* (() a -> b) (rec (l) (+ (*) (* a l)))) -> (rec (l) (+ (*) (* b l)))))
  (fun (a b) (p : (* (() a -> b) (rec (l) (+ (*) (* a l))))) : (rec (l) (+ (*) (* b l)))
    (split# ((f : (() a -> b)) (xs : (rec (l) (+ (*) (* a l))))) p
      (cases (unfold xs)
        ((_ : (*))
          (fold (rec (l) (+ (*) (* b l)))
            (inj 0 (tup) : (+ (*) (* b (rec (l) (+ (*) (* b l))))))))
        ((c : (* a (rec (l) (+ (*) (* a l)))))
          (fold (rec (l) (+ (*) (* b l)))
            (inj 1
              (tup (app f () (proj 0 c))
                   (app map (a b) (tup f (proj 1 c))))
              : (+ (*) (* b (rec (l) (+ (*) (* b l))))))))))))

(app map (int int)
  (tup (fun () (x : int) : int (op + x 1))
       (fold (rec (l) (+ (*) (* int l)))
         (inj 1
           (tup 1
             (fold (rec (l) (+ (*) (* int l)))
               (inj 1
                 (tup 2
                   (fold (rec (l) (+ (*) (* int l)))
                     (inj 0 (tup) : (+ (*) (* int (rec (l) (+ (*) (* int l))))))))
                 : (+ (*) (* int (rec (l) (+ (*) (* int l))))))))
           : (+ (*) (* int (rec (l) (+ (*) (* int l)))))))))
